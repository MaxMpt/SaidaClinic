SECRET_KEY=смените-на-случайную-длинную-строку
DEBUG=0
ALLOWED_HOSTS=your-domain.com,www.your-domain.com
CSRF_TRUSTED_ORIGINS=https://your-domain.com

# Пароль контейнера Postgres (тот же в DATABASE_URL)
POSTGRES_PASSWORD=смените-пароль-postgres

# Django на хосте + Postgres в Docker: хост 127.0.0.1
# Django тоже в Docker: compose сам подставит host=db
DATABASE_URL=postgres://docsaya:смените-пароль-postgres@127.0.0.1:5432/docsaya

TELEGRAM_BOT_TOKEN=
MINI_APP_URL=https://your-domain.com
ADMIN_TELEGRAM_ID=6935237776
